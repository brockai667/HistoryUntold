          "tags": [ "RESERVATION", { "text": "LIMITED", "tone": "yellow" } ] },
        { "title": "PERFORMANCE", "sub": "ROAD READY", "art": "car-red", "price": "$50,000", "tags": [ "DRIVES" ] } ] } },

    { "say": "Nobody owns the flying one. Looks useless.", "scene": "PriceList",
      "props": { "slots": 3, "cards": [
        { "title": "ROCKET", "sub": "AIR READY", "art": "car-fly", "price": "NO PRICE", "priceRed": true, "tags": [ "OWNERS = 0" ] },
        { "title": "THRUST", "sub": "RACE READY", "art": "car", "price": "$250,000",
