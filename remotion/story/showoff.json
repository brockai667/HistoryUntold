                 "anchor": { "label": "THE ANCHOR · FLIES", "art": "car-fly" } } },

    { "say": "You see it everywhere. A bakery adds a $1,900 cake for two hundred guests.", "scene": "Compare",
      "props": {
        "before": [ null,
