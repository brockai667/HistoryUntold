    { "say": "Job two: it moves the anchor. Alone, $50,000 feels expensive.", "scene": "Anchor",
      "props": { "job": "JOB 2 · MOVES THE ANCHOR", "price": "$50,000", "at": 0.6, "split": 0.42 } },

    { "say": "Float a flying car above it, and the same price starts to sound reasonable.", "scene": "Anchor",
