          { "title": "Cake · 200 guests", "sub": "BIG PARTY", "price": "$1,900", "top": { "text": "EXTREME", "tone": "red" } },
          { "title": "Birthday cake", "sub": "SERVES 12", "price": "$45" },
          { "title": "Cupcake", "sub": "ONE", "price": "$4" } ] } },

    { "say": "A coach adds a VIP plan, by application only.", "scene": "Compare",
      "props": {
        "before": [ null,
          { "title": "1:1 coaching", "sub": "PER MONTH", "price": "$300" },
          { "title": "Group call", "sub": "PER MONTH", "price": "$49" } ],
        "after": [
          { "title": "VIP coaching", "sub": "BY APPLICATION ONLY", "tags": [ { "text": "APPLY →", "tone": "dark" } ], "top": { "text": "EXTREME", "tone": "red" } },
          { "title": "1:1 coaching", "sub": "PER MONTH", "price": "$300" },
          { "title": "Group call", "sub": "PER MONTH", "price": "$49" } ] } },

    { "say": "Suddenly, $300 a month isn't pricey. It's the smart choice.", "scene": "Compare",
      "props": {
        "before": [ null,
          { "title": "1:1 coaching", "sub": "PER MONTH", "price": "$300", "badge": "PRICEY?" },
          { "title": "Group call", "sub": "PER MONTH", "price": "$49" } ],
        "after": [
          { "title": "VIP coaching", "sub": "BY APPLICATION ONLY", "tags": [ { "text": "APPLY →", "tone": "dark" } ], "top": { "text": "EXTREME", "tone": "red" } },
          { "title": "1:1 coaching", "sub": "PER MONTH", "price": "$300", "badge": { "text": "SMART CHOICE", "tone": "green" } },
          { "title": "Group call", "sub": "PER MONTH", "price": "$49" } ] } },

    { "say": "If something isn't for sale, ask what it's selling. Follow for more.", "scene": "Outro",
      "props": { "stamp": "DECOYED", "logo": "DECOY", "tagline": "THE TRICKS BEHIND WHAT YOU BUY", "cta": "FOLLOW FOR MORE →", "art": "car-fly" } }
